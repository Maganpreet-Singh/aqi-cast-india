   "source": [
    "## 8. Initialize the project workspace\n",
    "\n",
    "The directories below match the agreed repository architecture. Creating an existing directory is safe and does not delete its contents. Empty directories may not appear in Git until they contain a tracked file."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "5421c64d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Project workspace initialized successfully (17 directory groups checked).\n"
     ]
    }
   ],
   "source": [
    "created_count = 0\n",
    "for directory in PROJECT_DIRS.values():\n",
    "    existed = directory.exists()\n",
    "    directory.mkdir(parents=True, exist_ok=True)\n",
    "    if not existed:\n",
    "        created_count += 1\n",
    "\n",
    "print(f\"Project workspace initialized successfully ({len(PROJECT_DIRS)} directory groups checked).\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "acc3195c",
   "metadata": {},
   "source": [
    "## 9. Validate the Python runtime\n",
    "\n",
    "Python 3.11 is the recommended baseline for this project to provide a practical compatibility target across the data-science and application stack. The check below reports the active interpreter version rather than silently changing environments. Package compatibility can vary by operating system and hardware; resolve any missing or incompatible package before beginning the notebook that needs it."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "265ae8ab",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Python version: 3.14.7\n",
      "Python baseline: PASS\n",
      "Notebook kernel detected: Yes\n"
     ]
    }
   ],
   "source": [
    "python_version = platform.python_version()\n",
    "python_version_tuple = sys.version_info[:3]\n",
    "python_supported = sys.version_info >= (3, 10)\n",
    "\n",
    "runtime_summary = {\n",
    "    \"python_version\": python_version,\n",
    "    \"implementation\": platform.python_implementation(),\n",
    "    \"platform\": platform.system(),\n",
    "    \"architecture\": platform.machine(),\n",
    "    \"minimum_version_check\": \"PASS\" if python_supported else \"FAIL\",\n",
    "    \"recommended_version\": \"Python 3.11 (Python 3.10+ baseline)\",\n",
    "}\n",
    "\n",
    "try:\n",
    "    from IPython import get_ipython\n",
    "    notebook_kernel_active = get_ipython() is not None\n",
    "except Exception:\n",
    "    notebook_kernel_active = False\n",
    "\n",
    "print(f\"Python version: {python_version}\")\n",
    "print(f\"Python baseline: {'PASS' if python_supported else 'FAIL — use Python 3.10 or newer'}\")\n",
    "print(f\"Notebook kernel detected: {'Yes' if notebook_kernel_active else 'No'}\")"
   ]
  },
