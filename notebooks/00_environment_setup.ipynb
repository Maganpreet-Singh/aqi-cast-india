    "## 15. Inspect compute resources and optional GPU availability\n",
    "\n",
    "AQI-Cast India can be developed and trained on CPU. A GPU is not a prerequisite for the initial LightGBM workflow. The diagnostic below checks CPU count, available memory (when `psutil` is installed), and GPU visibility through PyTorch or the NVIDIA command-line utility. Missing GPU tooling is treated as informational, not as a setup failure."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "6407aff3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "CPU logical cores: 16\n",
      "Total memory (GiB): 15.82\n",
      "Available memory (GiB): 2.71\n",
      "GPU detected: True\n",
      "GPU devices: ['NVIDIA GeForce RTX 3050 Laptop GPU']\n",
      "GPU detection method: NVIDIA System Management Interface\n"
     ]
    }
   ],
   "source": [
    "cpu_count = os.cpu_count() or 1\n",
    "memory_total_gib = None\n",
    "memory_available_gib = None\n",
    "try:\n",
    "    import psutil\n",
    "    memory = psutil.virtual_memory()\n",
    "    memory_total_gib = round(memory.total / (1024 ** 3), 2)\n",
    "    memory_available_gib = round(memory.available / (1024 ** 3), 2)\n",
    "except ImportError:\n",
    "    pass\n",
    "\n",
    "gpu_devices = []\n",
    "gpu_detection_method = \"No GPU diagnostic tool available\"\n",
    "\n",
    "# First try PyTorch, if already installed.\n",
    "try:\n",
    "    if importlib.util.find_spec(\"torch\") is not None:\n",
    "        import torch\n",
    "        if torch.cuda.is_available():\n",
    "            gpu_devices = [torch.cuda.get_device_name(i) for i in range(torch.cuda.device_count())]\n",
    "            gpu_detection_method = \"PyTorch CUDA\"\n",
    "        else:\n",
    "            gpu_detection_method = \"PyTorch installed; CUDA device not available\"\n",
    "except Exception:\n",
    "    gpu_detection_method = \"PyTorch GPU check unavailable\"\n",
    "\n",
    "# Fall back to nvidia-smi if PyTorch did not identify a GPU.\n",
    "if not gpu_devices and shutil.which(\"nvidia-smi\"):\n",
    "    try:\n",
    "        result = subprocess.run(\n",
    "            [\"nvidia-smi\", \"--query-gpu=name\", \"--format=csv,noheader\"],\n",
    "            capture_output=True,\n",
    "            text=True,\n",
    "            timeout=10,\n",
    "            check=False,\n",
    "        )\n",
    "        if result.returncode == 0:\n",
    "            gpu_devices = [line.strip() for line in result.stdout.splitlines() if line.strip()]\n",
    "            gpu_detection_method = \"NVIDIA System Management Interface\"\n",
    "    except (subprocess.TimeoutExpired, OSError):\n",
    "        pass\n",
    "\n",
    "resource_summary = {\n",
    "    \"CPU logical cores\": cpu_count,\n",
    "    \"Total memory (GiB)\": memory_total_gib if memory_total_gib is not None else \"Not available\",\n",
    "    \"Available memory (GiB)\": memory_available_gib if memory_available_gib is not None else \"Not available\",\n",
    "    \"GPU detected\": bool(gpu_devices),\n",
    "    \"GPU devices\": gpu_devices if gpu_devices else [\"No supported GPU detected; CPU workflow is supported\"],\n",
    "    \"GPU detection method\": gpu_detection_method,\n",
    "}\n",
    "\n",
    "for key, value in resource_summary.items():\n",
    "    print(f\"{key}: {value}\")"
   ]
  },
