   "source": [
    "python_version = platform.python_version()\n",
    "python_version_tuple = sys.version_info[:3]\n",
    "python_supported = sys.version_info >= (3, 10)\n",
    "\n",
    "runtime_summary = {\n",
    "    \"python_version\": python_version,\n",
    "    \"implementation\": platform.python_implementation(),\n",
    "    \"platform\": platform.system(),\n",
    "    \"architecture\": platform.machine(),\n",
    "    \"minimum_version_check\": \"PASS\" if python_supported else \"FAIL\",\n",
    "    \"recommended_version\": \"Python 3.11 (Python 3.10+ baseline)\",\n",
    "}\n",
    "\n",
    "try:\n",
    "    from IPython import get_ipython\n",
    "    notebook_kernel_active = get_ipython() is not None\n",
    "except Exception:\n",
    "    notebook_kernel_active = False\n",
    "\n",
    "print(f\"Python version: {python_version}\")\n",
    "print(f\"Python baseline: {'PASS' if python_supported else 'FAIL — use Python 3.10 or newer'}\")\n",
    "print(f\"Notebook kernel detected: {'Yes' if notebook_kernel_active else 'No'}\")"
   ]
