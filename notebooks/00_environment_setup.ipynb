    "from importlib import metadata\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "from tempfile import NamedTemporaryFile\n",
    "\n",
    "# Shared project defaults. Keep these consistent across later notebooks.\n",
    "PROJECT_NAME = \"AQI-Cast India\"\n",
    "PROJECT_SLUG = \"aqi-cast-india\"\n",
    "RANDOM_SEED = 42\n",
    "FORECAST_HORIZONS = tuple(range(1, 8))\n",
    "TARGET_COLUMN = \"AQI\"\n",
    "CITY_COLUMN = \"City\"\n",
    "DATE_COLUMN = \"Date\"\n",
    "\n",
    "# Set process-level defaults without overriding user-managed settings.\n",
    "os.environ.setdefault(\"PYTHONHASHSEED\", str(RANDOM_SEED))\n",
    "os.environ.setdefault(\"OMP_NUM_THREADS\", str(max(1, min(8, os.cpu_count() or 1))))\n",
    "os.environ.setdefault(\"MKL_NUM_THREADS\", str(max(1, min(8, os.cpu_count() or 1))))\n",
    "os.environ.setdefault(\"OPENBLAS_NUM_THREADS\", str(max(1, min(8, os.cpu_count() or 1))))\n",
    "\n",
    "random.seed(RANDOM_SEED)\n",
    "\n",
    "print(\"Runtime initialization completed.\")"
