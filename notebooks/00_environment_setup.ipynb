   "source": [
    "def get_package_status(distribution_name: str, module_name: str) -> dict:\n",
    "    \"\"\"Return availability and version information for one package.\"\"\"\n",
    "    try:\n",
    "        available = importlib.util.find_spec(module_name) is not None\n",
    "    except (ImportError, ModuleNotFoundError, ValueError):\n",
    "        available = False\n",
    "\n",
    "    try:\n",
    "        version = metadata.version(distribution_name) if available else None\n",
    "    except metadata.PackageNotFoundError:\n",
    "        version = \"Installed; version metadata unavailable\" if available else None\n",
    "\n",
    "    return {\n",
    "        \"Package\": distribution_name,\n",
    "        \"Module available\": available,\n",
    "        \"Version\": version or \"—\",\n",
    "        \"Foundation requirement\": distribution_name in REQUIRED_FOR_FOUNDATION,\n",
    "    }\n",
    "\n",
    "package_status_records = []\n",
    "for group_name, package_names in PACKAGE_GROUPS.items():\n",
    "    for package_name in package_names:\n",
    "        record = get_package_status(package_name, PACKAGE_MODULES[package_name])\n",
    "        record[\"Group\"] = group_name\n",
    "        package_status_records.append(record)\n",
    "\n",
    "try:\n",
    "    import pandas as pd\n",
    "    package_status_df = pd.DataFrame(package_status_records)\n",
    "    package_status_df = package_status_df[[\n",
    "        \"Group\", \"Package\", \"Module available\", \"Version\", \"Foundation requirement\"\n",
    "    ]]\n",
    "    display(package_status_df)\n",
    "except Exception:\n",
    "    for record in package_status_records:\n",
    "        print(record)\n",
    "\n",
    "missing_foundation = [\n",
