    "## 18. Create shared save helpers\n",
    "\n",
    "These helpers centralize file export behavior for later notebooks. Image and artifact destinations are kept separate. Success messages intentionally do not reveal the saved file's path. The helpers accept a filename, not an arbitrary directory, to reduce accidental output sprawl."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "f503de69",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Shared image and artifact export helpers are ready.\n"
     ]
    }
   ],
   "source": [
    "def _validate_output_filename(filename: str) -> str:\n",
    "    \"\"\"Reject path components so exports stay inside their designated area.\"\"\"\n",
    "    candidate = Path(filename)\n",
    "    if candidate.name != filename or filename in {\"\", \".\", \"..\"}:\n",
    "        raise ValueError(\"Provide a filename only; directory components are not allowed.\")\n",
    "    return filename\n",
    "\n",
    "\n",
    "def save_artifact_bytes(data: bytes, filename: str) -> None:\n",
    "    \"\"\"Save bytes into the artifact area without printing a filesystem path.\"\"\"\n",
    "    safe_name = _validate_output_filename(filename)\n",
    "    (PROJECT_DIRS[\"artifacts\"] / safe_name).write_bytes(data)\n",
    "    print(\"Artifact generated successfully.\")\n",
    "\n",
    "\n",
    "def save_artifact_json(data: dict, filename: str, indent: int = 2) -> None:\n",
    "    \"\"\"Serialize a JSON-compatible object into the artifact area.\"\"\"\n",
    "    safe_name = _validate_output_filename(filename)\n",
    "    output = PROJECT_DIRS[\"artifacts\"] / safe_name\n",
    "    output.write_text(json.dumps(data, indent=indent, ensure_ascii=False, default=str) + \"\\n\", encoding=\"utf-8\")\n",
    "    print(\"Artifact generated successfully.\")\n",
    "\n",
    "\n",
    "def save_figure(fig, filename: str, dpi: int = 300, **kwargs) -> None:\n",
    "    \"\"\"Save a Matplotlib figure in the image area and close it.\"\"\"\n",
    "    safe_name = _validate_output_filename(filename)\n",
    "    if not safe_name.lower().endswith((\".png\", \".jpg\", \".jpeg\", \".svg\", \".pdf\")):\n",
    "        raise ValueError(\"Use a supported image extension: png, jpg, jpeg, svg, or pdf.\")\n",
    "    output = PROJECT_DIRS[\"images\"] / safe_name\n",
    "    fig.savefig(output, dpi=dpi, bbox_inches=\"tight\", **kwargs)\n",
    "    try:\n",
    "        import matplotlib.pyplot as plt\n",
    "        plt.close(fig)\n",
    "    except ImportError:\n",
    "        pass\n",
    "    print(\"Visualization saved successfully.\")\n",
    "\n",
    "\n",
    "def save_plotly_figure(fig, filename: str, include_html: bool = False) -> None:\n",
    "    \"\"\"Save a Plotly figure as an image, optionally also exporting HTML.\"\"\"\n",
    "    safe_name = _validate_output_filename(filename)\n",
    "    if not safe_name.lower().endswith((\".png\", \".jpg\", \".jpeg\", \".svg\", \".pdf\")):\n",
    "        raise ValueError(\"Use a supported image extension: png, jpg, jpeg, svg, or pdf.\")\n",
    "    output = PROJECT_DIRS[\"images\"] / safe_name\n",
    "    try:\n",
    "        fig.write_image(str(output))\n",
    "    except Exception as exc:\n",
    "        raise RuntimeError(\n",
    "            \"Plotly image export requires a compatible image-export engine. \"\n",
    "            \"Install or repair the Plotly image-export dependency, then retry.\"\n",
    "        ) from exc\n",
    "    if include_html:\n",
    "        html_name = Path(safe_name).stem + \".html\"\n",
    "        fig.write_html(str(PROJECT_DIRS[\"images\"] / html_name), include_plotlyjs=\"cdn\")\n",
    "    print(\"Interactive visualization exported successfully.\" if include_html else \"Visualization saved successfully.\")\n",
    "\n",
    "\n",
    "print(\"Shared image and artifact export helpers are ready.\")"
   ]
  },
