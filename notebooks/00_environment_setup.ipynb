   "source": [
    "## 7. Identify the project root\n",
    "\n",
    "The project root is located by checking the current working directory and its parents for the expected notebook directory. If the repository has not been initialized yet, the notebook uses a safe fallback based on the current working directory. The resolved location is used internally and is never printed."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "4356cc32",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Project workspace identified successfully.\n"
     ]
    }
   ],
   "source": [
    "def find_project_root(start: Path | None = None) -> Path:\n",
    "    \"\"\"Find the repository root without displaying the resolved location.\"\"\"\n",
    "    start = (start or Path.cwd()).resolve()\n",
    "    candidates = [start, *start.parents]\n",
    "\n",
    "    for candidate in candidates:\n",
    "        if (candidate / \"notebooks\").is_dir():\n",
    "            return candidate\n",
    "\n",
    "    if start.name.lower() == \"notebooks\":\n",
    "        return start.parent\n",
    "\n",
    "    return start\n",
    "\n",
    "\n",
    "PROJECT_ROOT = find_project_root()\n",
    "\n",
    "# Canonical project locations. These values are used internally by later cells.\n",
    "PROJECT_DIRS = {\n",
    "    \"configs\": PROJECT_ROOT / \"configs\",\n",
    "    \"data_raw\": PROJECT_ROOT / \"data\" / \"raw\",\n",
    "    \"data_processed\": PROJECT_ROOT / \"data\" / \"processed\",\n",
    "    \"data_features\": PROJECT_ROOT / \"data\" / \"features\",\n",
    "    \"data_sample\": PROJECT_ROOT / \"data\" / \"sample\",\n",
    "    \"notebooks\": PROJECT_ROOT / \"notebooks\",\n",
    "    \"sql\": PROJECT_ROOT / \"sql\",\n",
    "    \"src_package\": PROJECT_ROOT / \"src\" / \"aqicast\",\n",
    "    \"application_entrypoints\": PROJECT_ROOT / \"src\" / \"aqicast\" / \"application_entrypoints\",\n",
    "    \"models\": PROJECT_ROOT / \"models\",\n",
