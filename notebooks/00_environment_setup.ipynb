   ],
   "source": [
    "CONFIG_VALID = False\n",
    "CONFIG_DATA = None\n",
    "CONFIG_VALIDATION_MESSAGES = []\n",
    "\n",
    "if yaml_available:\n",
    "    try:\n",
    "        CONFIG_DATA = yaml.safe_load(CONFIG_FILE.read_text(encoding=\"utf-8\"))\n",
    "        required_config_sections = [\"project\", \"data\", \"forecasting\", \"modeling\", \"paths\"]\n",
    "        missing_sections = [\n",
    "            section for section in required_config_sections\n",
    "            if not isinstance(CONFIG_DATA, dict) or section not in CONFIG_DATA\n",
    "        ]\n",
    "        if missing_sections:\n",
    "            CONFIG_VALIDATION_MESSAGES.append(\n",
    "                \"Missing required configuration sections: \" + \", \".join(missing_sections)\n",
    "            )\n",
    "        else:\n",
    "            configured_horizons = CONFIG_DATA[\"forecasting\"].get(\"horizons_days\", [])\n",
    "            if configured_horizons != list(FORECAST_HORIZONS):\n",
    "                CONFIG_VALIDATION_MESSAGES.append(\"Forecast horizons differ from the project standard.\")\n",
    "            if CONFIG_DATA[\"data\"].get(\"target_column\") != TARGET_COLUMN:\n",
    "                CONFIG_VALIDATION_MESSAGES.append(\"Configured target column differs from the project standard.\")\n",
    "            if not CONFIG_VALIDATION_MESSAGES:\n",
    "                CONFIG_VALID = True\n",
    "    except Exception as exc:\n",
    "        CONFIG_VALIDATION_MESSAGES.append(f\"Configuration could not be parsed ({type(exc).__name__}).\")\n",
    "else:\n",
    "    CONFIG_VALIDATION_MESSAGES.append(\"Install PyYAML to parse and validate the YAML configuration.\")\n",
    "\n",
    "if CONFIG_VALID:\n",
    "    print(\"Project configuration parsed and validated successfully.\")\n",
