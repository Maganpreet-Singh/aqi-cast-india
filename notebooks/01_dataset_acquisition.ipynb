    "def read_csv_with_encoding_fallback(file_path: Path) -> tuple[pd.DataFrame, str]:\n",
    "    \"\"\"Read a CSV using common text encodings without displaying local paths.\"\"\"\n",
    "    last_error = None\n",
    "    for encoding in (\"utf-8-sig\", \"utf-8\", \"latin-1\"):\n",
    "        try:\n",
    "            frame = pd.read_csv(file_path, low_memory=False, encoding=encoding)\n",
    "            return frame, encoding\n",
    "        except UnicodeDecodeError as exc:\n",
    "            last_error = exc\n",
    "        except Exception as exc:\n",
    "            raise RuntimeError(\n",
    "                f\"The primary CSV could not be parsed ({type(exc).__name__}). \"\n",
    "                \"Check whether the downloaded file is a valid CSV.\"\n",
    "            ) from None\n",
    "    raise RuntimeError(\"The primary CSV could not be decoded using the supported text encodings.\") from None\n",
    "\n",
    "\n",
    "primary_df, PRIMARY_FILE_ENCODING = read_csv_with_encoding_fallback(PRIMARY_CSV_PATH)\n",
    "primary_df.columns = [str(column).strip() for column in primary_df.columns]\n",
    "\n",
    "if primary_df.columns.duplicated().any():\n",
    "    duplicate_names = primary_df.columns[primary_df.columns.duplicated()].tolist()\n",
    "    raise ValueError(f\"Duplicate column names detected after trimming whitespace: {duplicate_names}\")\n",
    "\n",
    "required_columns = [CITY_COLUMN, DATE_COLUMN, TARGET_COLUMN]\n",
    "missing_required_columns = [column for column in required_columns if column not in primary_df.columns]\n",
    "if missing_required_columns:\n",
    "    raise ValueError(\n",
    "        \"The selected primary CSV is missing required forecasting fields: \"\n",
    "        + \", \".join(missing_required_columns)\n",
    "        + \". Select a city-level daily CSV containing City, Date, and AQI.\"\n",
    "    )\n",
    "\n",
    "if primary_df.empty:\n",
    "    raise ValueError(\"The primary city-level daily dataset contains no observations.\")\n",
    "\n",
    "print(\"Primary city-level daily dataset loaded successfully.\")\n",
    "print(f\"Rows available: {len(primary_df):,}\")\n",
    "print(f\"Columns available: {len(primary_df.columns)}\")\n",
    "print(f\"Text encoding used: {PRIMARY_FILE_ENCODING}\")"
