   "source": [
    "## 15. Build the reproducible dataset manifest\n",
    "\n",
    "The manifest captures dataset provenance, acquisition method, inventory details, primary-file schema, measured date coverage, data-quality signals, and file checksums.\n",
    "\n",
    "The manifest deliberately excludes local absolute paths, Kaggle credentials, and machine-specific directory information. The source dataset itself remains in `data/raw/`; only the generated manifest is written to `artifacts/`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "8f96ba8e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Dataset manifest saved successfully.\n"
     ]
    }
   ],
   "source": [
    "DATASET_MANIFEST = {\n",
    "    \"manifest_version\": \"1.0\",\n",
    "    \"project\": PROJECT_NAME,\n",
    "    \"created_at_utc\": datetime.now(timezone.utc).isoformat(),\n",
    "    \"source\": {\n",
    "        \"title\": \"Air Quality Data in India (2015 - 2020)\",\n",
    "        \"provider\": \"Kaggle\",\n",
    "        \"dataset_handle\": DATASET_HANDLE,\n",
    "        \"dataset_url\": DATASET_URL,\n",
    "        \"metadata_url\": DATASET_METADATA_URL,\n",
    "        \"compiler\": \"Rohan Rao (as stated in the Transport Data Commons metadata record)\",\n",
    "        \"upstream_data_provider\": \"Central Pollution Control Board (CPCB), India\",\n",
    "        \"reference_period\": {\n",
    "            \"start\": \"2015-01-01\",\n",
    "            \"end\": \"2020-12-31\",\n",
    "            \"basis\": \"Transport Data Commons dataset metadata\",\n",
    "        },\n",
    "        \"metadata_listed_license\": \"CC0 1.0 (Transport Data Commons listing; verify the current Kaggle listing before redistribution)\",\n",
    "        \"live_data_available\": False,\n",
    "    },\n",
    "    \"acquisition\": {\n",
    "        \"method\": ACQUISITION_METHOD,\n",
    "        \"acquired_at_utc\": datetime.now(timezone.utc).isoformat(),\n",
    "        \"primary_filename\": PRIMARY_CSV_FILENAME,\n",
    "        \"encoding_used_for_primary_file\": PRIMARY_FILE_ENCODING,\n",
    "        \"kagglehub_used\": ACQUISITION_METHOD == \"kagglehub_download\",\n",
    "    },\n",
    "    \"project_contract\": {\n",
    "        \"city_column\": CITY_COLUMN,\n",
    "        \"date_column\": DATE_COLUMN,\n",
    "        \"target_column\": TARGET_COLUMN,\n",
    "        \"forecast_horizons_days\": list(FORECAST_HORIZONS),\n",
    "        \"operating_mode\": \"historical_replay_and_backtesting\",\n",
    "    },\n",
    "    \"inventory\": inventory_records,\n",
    "    \"primary_dataset\": {\n",
    "        **primary_summary,\n",
    "        \"filename\": PRIMARY_CSV_FILENAME,\n",
    "        \"columns\": [str(column) for column in primary_df.columns],\n",
    "        \"dtypes\": {str(column): str(dtype) for column, dtype in primary_df.dtypes.items()},\n",
    "        \"missing_values_by_column\": {\n",
    "            str(column): int(value) for column, value in primary_df.isna().sum().items()\n",
    "        },\n",
    "        \"missing_percentage_by_column\": {\n",
    "            str(column): round(float(value), 4)\n",
    "            for column, value in (primary_df.isna().mean() * 100).items()\n",
    "        },\n",
    "        \"minimum_schema_valid\": PRIMARY_SCHEMA_VALID,\n",
    "        \"validation_checks\": [\n",
    "            {\"check\": label, \"passed\": bool(passed)}\n",
    "            for label, passed in validation_checks\n",
    "        ],\n",
    "    },\n",
    "    \"limitations\": [\n",
    "        \"The source is historical and does not provide real-time 2026 AQI observations.\",\n",
    "        \"The actual file list and schema were inspected at acquisition time; other dataset versions may differ.\",\n",
    "        \"This notebook does not clean, impute, interpolate, deduplicate, clip, or recalculate AQI values.\",\n",
    "        \"A valid schema does not establish data quality, representativeness, or forecasting performance.\",\n",
    "        \"The metadata-listed license should be checked against the current Kaggle listing before redistribution.\",\n",
    "    ],\n",
    "}\n",
    "\n",
    "\n",
    "def save_manifest(manifest: dict[str, Any], filename: str = \"dataset_manifest.json\") -> None:\n",
    "    \"\"\"Save the dataset manifest under artifacts/ without printing its path.\"\"\"\n",
    "    if Path(filename).name != filename or filename in {\"\", \".\", \"..\"}:\n",
    "        raise ValueError(\"Manifest output must be a filename without directory components.\")\n",
    "    output_file = PROJECT_DIRS[\"artifacts\"] / filename\n",
    "    output_file.write_text(\n",
    "        json.dumps(manifest, indent=2, ensure_ascii=False, default=str) + \"\\n\",\n",
    "        encoding=\"utf-8\",\n",
    "    )\n",
    "    print(\"Dataset manifest saved successfully.\")\n",
    "\n",
    "\n",
    "save_manifest(DATASET_MANIFEST)"
   ]
  },
