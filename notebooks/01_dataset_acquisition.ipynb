    "def sha256_file(file_path: Path, block_size: int = 1024 * 1024) -> str:\n",
    "    \"\"\"Calculate a streaming SHA-256 checksum without loading the file into memory.\"\"\"\n",
    "    digest = hashlib.sha256()\n",
    "    with file_path.open(\"rb\") as stream:\n",
    "        for block in iter(lambda: stream.read(block_size), b\"\"):\n",
    "            digest.update(block)\n",
    "    return digest.hexdigest()\n",
    "\n",
    "\n",
    "def detect_text_encoding(file_path: Path) -> str:\n",
    "    \"\"\"Use a conservative encoding fallback for reading CSV headers and metadata.\"\"\"\n",
    "    for encoding in (\"utf-8-sig\", \"utf-8\", \"latin-1\"):\n",
    "        try:\n",
    "            with file_path.open(\"r\", encoding=encoding, newline=\"\") as stream:\n",
    "                next(csv.reader(stream), None)\n",
    "            return encoding\n",
    "        except UnicodeDecodeError:\n",
    "            continue\n",
    "    return \"latin-1\"\n",
    "\n",
    "\n",
    "def inspect_csv_file(file_path: Path) -> dict[str, Any]:\n",
    "    \"\"\"Collect path-free metadata for a single CSV file.\"\"\"\n",
    "    encoding = detect_text_encoding(file_path)\n",
    "    header_df = pd.read_csv(file_path, nrows=0, encoding=encoding)\n",
    "    columns = [str(column).strip() for column in header_df.columns]\n",
    "\n",
    "    with file_path.open(\"r\", encoding=encoding, newline=\"\") as stream:\n",
    "        reader = csv.reader(stream)\n",
    "        next(reader, None)\n",
    "        row_count = sum(1 for _ in reader)\n",
    "\n",
    "    date_column = next(\n",
    "        (column for column in columns if column.lower() in {\"date\", \"datetime\", \"date_time\"}),\n",
    "        None,\n",
    "    )\n",
    "    date_min = None\n",
    "    date_max = None\n",
    "\n",
    "    if date_column is not None:\n",
    "        try:\n",
    "            for chunk in pd.read_csv(\n",
    "                file_path,\n",
    "                usecols=[date_column],\n",
    "                dtype={date_column: \"string\"},\n",
    "                chunksize=CSV_SCAN_CHUNK_SIZE,\n",
    "                encoding=encoding,\n",
    "            ):\n",
    "                parsed = pd.to_datetime(chunk[date_column], errors=\"coerce\")\n",
    "                if parsed.notna().any():\n",
    "                    chunk_min = parsed.min()\n",
    "                    chunk_max = parsed.max()\n",
    "                    date_min = chunk_min if date_min is None else min(date_min, chunk_min)\n",
    "                    date_max = chunk_max if date_max is None else max(date_max, chunk_max)\n",
    "        except Exception:\n",
    "            # The primary dataset is checked more strictly below.\n",
    "            date_min = None\n",
    "            date_max = None\n",
    "\n",
    "    return {\n",
    "        \"filename\": file_path.name,\n",
    "        \"size_bytes\": int(file_path.stat().st_size),\n",
    "        \"size_mb\": round(file_path.stat().st_size / (1024 ** 2), 3),\n",
    "        \"row_count\": int(row_count),\n",
    "        \"columns\": columns,\n",
    "        \"date_column\": date_column,\n",
    "        \"date_min\": date_min.date().isoformat() if date_min is not None else None,\n",
    "        \"date_max\": date_max.date().isoformat() if date_max is not None else None,\n",
    "        \"sha256\": sha256_file(file_path),\n",
    "        \"scan_status\": \"completed\",\n",
    "    }\n",
    "\n",
    "\n",
    "CSV_FILES = list_csv_files(DATASET_ROOT)\n",
    "if not CSV_FILES:\n",
    "    raise FileNotFoundError(\"No CSV files were found in the selected dataset collection.\")\n",
    "\n",
    "inventory_records = []\n",
    "for csv_file in CSV_FILES:\n",
    "    try:\n",
    "        inventory_records.append(inspect_csv_file(csv_file))\n",
    "    except Exception as exc:\n",
    "        inventory_records.append({\n",
    "            \"filename\": csv_file.name,\n",
    "            \"size_bytes\": int(csv_file.stat().st_size),\n",
    "            \"size_mb\": round(csv_file.stat().st_size / (1024 ** 2), 3),\n",
    "            \"row_count\": None,\n",
    "            \"columns\": [],\n",
    "            \"date_column\": None,\n",
    "            \"date_min\": None,\n",
    "            \"date_max\": None,\n",
    "            \"sha256\": sha256_file(csv_file),\n",
    "            \"scan_status\": f\"scan_failed_{type(exc).__name__}\",\n",
    "        })\n",
    "\n",
    "inventory_df = pd.DataFrame(inventory_records)\n",
    "inventory_display = inventory_df[[\n",
    "    \"filename\", \"size_mb\", \"row_count\", \"date_min\", \"date_max\", \"scan_status\"\n",
    "]].rename(columns={\n",
    "    \"filename\": \"File\",\n",
    "    \"size_mb\": \"Size (MB)\",\n",
    "    \"row_count\": \"Records\",\n",
    "    \"date_min\": \"First date\",\n",
    "    \"date_max\": \"Last date\",\n",
    "    \"scan_status\": \"Scan status\",\n",
    "})\n",
    "display(inventory_display)\n",
    "print(f\"CSV files inventoried: {len(inventory_records)}\")"
   ]
