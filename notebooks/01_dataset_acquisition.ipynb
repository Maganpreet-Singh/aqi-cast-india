    "## 9. Dataset discovery and acquisition helpers\n",
    "\n",
    "The downloader checks the installed KaggleHub function signature before passing optional arguments. This keeps the notebook compatible with releases that may not expose the same keyword parameters.\n",
    "\n",
    "For local/manual acquisition, point `AQICAST_LOCAL_DATASET_DIR` to the extracted dataset folder or place the CSV files under `data/raw/`. The discovery logic searches recursively but reports filenames only, never full paths."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "2c278c75",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Dataset acquisition helpers are ready.\n"
     ]
    }
   ],
   "source": [
    "def find_primary_csv(search_root: Path, filename: str = PRIMARY_CSV_FILENAME) -> Path | None:\n",
    "    \"\"\"Find the requested primary CSV, preferring the shallowest matching file.\"\"\"\n",
    "    if not search_root.exists() or not search_root.is_dir():\n",
    "        return None\n",
    "    matches = [\n",
    "        candidate\n",
    "        for candidate in search_root.rglob(\"*.csv\")\n",
    "        if candidate.is_file()\n",
    "        and candidate.name.lower() == filename.lower()\n",
    "        and \".ipynb_checkpoints\" not in candidate.parts\n",
    "    ]\n",
    "    if not matches:\n",
    "        return None\n",
    "    matches.sort(key=lambda item: (len(item.parts), item.name.lower(), item.stat().st_size))\n",
    "    return matches[0]\n",
    "\n",
    "\n",
    "def list_csv_files(search_root: Path) -> list[Path]:\n",
    "    \"\"\"Return CSV files below a dataset folder, excluding notebook checkpoints.\"\"\"\n",
    "    if not search_root.exists() or not search_root.is_dir():\n",
    "        return []\n",
    "    return sorted(\n",
    "        [\n",
    "            item for item in search_root.rglob(\"*.csv\")\n",
    "            if item.is_file() and \".ipynb_checkpoints\" not in item.parts\n",
    "        ],\n",
    "        key=lambda item: (len(item.parts), item.name.lower()),\n",
    "    )\n",
    "\n",
    "\n",
    "def download_with_kagglehub() -> Path:\n",
    "    \"\"\"Download the public dataset into the standard raw-data area.\"\"\"\n",
    "    if importlib.util.find_spec(\"kagglehub\") is None:\n",
    "        raise RuntimeError(\n",
    "            \"KaggleHub is not installed. Install it with '%pip install -U kagglehub', \"\n",
    "            \"or use local/manual acquisition.\"\n",
    "        )\n",
    "\n",
    "    import kagglehub\n",
    "\n",
    "    DOWNLOAD_DIR.mkdir(parents=True, exist_ok=True)\n",
    "    download_function = kagglehub.dataset_download\n",
    "    parameters = inspect.signature(download_function).parameters\n",
    "\n",
    "    try:\n",
    "        if \"output_dir\" in parameters:\n",
    "            kwargs: dict[str, Any] = {\"output_dir\": str(DOWNLOAD_DIR)}\n",
    "            if \"force_download\" in parameters:\n",
    "                kwargs[\"force_download\"] = FORCE_KAGGLE_DOWNLOAD\n",
    "            returned_location = download_function(DATASET_HANDLE, **kwargs)\n",
    "            return Path(returned_location) if returned_location else DOWNLOAD_DIR\n",
    "\n",
    "        # Compatibility fallback for older KaggleHub versions without output_dir.\n",
    "        kwargs = {}\n",
    "        if \"force_download\" in parameters:\n",
    "            kwargs[\"force_download\"] = FORCE_KAGGLE_DOWNLOAD\n",
    "        cached_location = Path(download_function(DATASET_HANDLE, **kwargs))\n",
    "        if cached_location.resolve() != DOWNLOAD_DIR.resolve():\n",
    "            shutil.copytree(cached_location, DOWNLOAD_DIR, dirs_exist_ok=True)\n",
    "        return DOWNLOAD_DIR\n",
    "    except Exception as exc:\n",
    "        # Do not expose raw exception text: it can contain local paths or credential details.\n",
    "        raise RuntimeError(\n",
    "            f\"KaggleHub download failed ({type(exc).__name__}). Check network access and \"\n",
    "            \"Kaggle authentication/consent, or use the local/manual download method.\"\n",
    "        ) from None\n",
    "\n",
    "\n",
    "def acquire_dataset() -> tuple[Path, str]:\n",
    "    \"\"\"Resolve the dataset root and record how the source was obtained.\"\"\"\n",
    "    local_match = find_primary_csv(LOCAL_DATASET_DIR)\n",
    "\n",
    "    if ACQUISITION_MODE == \"local\":\n",
    "        if local_match is None:\n",
    "            raise FileNotFoundError(\n",
    "                \"The requested primary CSV was not found in the configured local dataset folder. \"\n",
    "                \"Update AQICAST_LOCAL_DATASET_DIR or place the extracted CSV files under data/raw/.\"\n",
    "            )\n",
    "        return local_match.parent, \"local_import\"\n",
    "\n",
    "    if ACQUISITION_MODE == \"auto\" and local_match is not None:\n",
    "        return local_match.parent, \"local_import\"\n",
    "\n",
    "    downloaded_root = download_with_kagglehub()\n",
    "    downloaded_match = find_primary_csv(downloaded_root)\n",
    "    if downloaded_match is None:\n",
    "        discovered_names = [item.name for item in list_csv_files(downloaded_root)]\n",
    "        if discovered_names:\n",
    "            names_preview = \", \".join(discovered_names[:12])\n",
    "            raise FileNotFoundError(\n",
    "                f\"The dataset download completed, but {PRIMARY_CSV_FILENAME} was not found. \"\n",
    "                f\"CSV files discovered: {names_preview}. Set AQICAST_PRIMARY_CSV_FILENAME \"\n",
    "                \"only when a different file contains the required City, Date, and AQI fields.\"\n",
    "            )\n",
    "        raise FileNotFoundError(\n",
    "            \"The dataset download completed, but no CSV files were discovered. \"\n",
    "            \"Check the Kaggle dataset contents and try again.\"\n",
    "        )\n",
    "    return downloaded_match.parent, \"kagglehub_download\"\n",
    "\n",
    "print(\"Dataset acquisition helpers are ready.\")"
   ]
  },
