    "parsed_dates = pd.to_datetime(primary_df[DATE_COLUMN], errors=\"coerce\")\n",
    "numeric_aqi = pd.to_numeric(primary_df[TARGET_COLUMN], errors=\"coerce\")\n",
    "city_values = primary_df[CITY_COLUMN].astype(\"string\").str.strip()\n",
    "\n",
    "complete_city_date = pd.DataFrame({CITY_COLUMN: city_values, DATE_COLUMN: parsed_dates})\n",
    "complete_city_date_mask = complete_city_date[CITY_COLUMN].notna() & complete_city_date[DATE_COLUMN].notna()\n",
    "duplicate_city_date_count = int(\n",
    "    complete_city_date.loc[complete_city_date_mask].duplicated([CITY_COLUMN, DATE_COLUMN]).sum()\n",
    ")\n",
    "\n",
    "valid_date_count = int(parsed_dates.notna().sum())\n",
    "valid_aqi_count = int(numeric_aqi.notna().sum())\n",
    "city_count = int(city_values.dropna().nunique())\n",
    "\n",
    "primary_summary = {\n",
    "    \"rows\": int(len(primary_df)),\n",
    "    \"columns\": int(len(primary_df.columns)),\n",
    "    \"city_count\": city_count,\n",
    "    \"date_min\": parsed_dates.min().date().isoformat() if valid_date_count else None,\n",
    "    \"date_max\": parsed_dates.max().date().isoformat() if valid_date_count else None,\n",
    "    \"valid_date_rows\": valid_date_count,\n",
    "    \"invalid_or_missing_date_rows\": int(len(primary_df) - valid_date_count),\n",
    "    \"valid_numeric_aqi_rows\": valid_aqi_count,\n",
    "    \"invalid_or_missing_aqi_rows\": int(len(primary_df) - valid_aqi_count),\n",
    "    \"duplicate_city_date_rows\": duplicate_city_date_count,\n",
    "    \"missing_city_rows\": int(primary_df[CITY_COLUMN].isna().sum()),\n",
    "    \"aqi_min\": float(numeric_aqi.min()) if valid_aqi_count else None,\n",
    "    \"aqi_max\": float(numeric_aqi.max()) if valid_aqi_count else None,\n",
    "    \"negative_aqi_rows\": int((numeric_aqi < 0).sum()),\n",
